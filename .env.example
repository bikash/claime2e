# --- database -----------------------------------------------------------------
# Postgres runs in the already-running `counted-db-1` Docker container
# (pgvector/pgvector:pg17), reachable on localhost:5432. start.sh creates the
# database and a dedicated role inside it on first run.
PG_CONTAINER=counted-db-1
PG_SUPERUSER=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=jb_auto_ai
PG_USER=jbauto
PG_PASSWORD=jbauto_dev_pw

# What the app connects with. Keep in sync with the values above.
# Quoted: start.sh sources this file, and bare semicolons would split the value.
PG_CONNSTRING="Host=localhost;Port=5432;Database=jb_auto_ai;Username=jbauto;Password=jbauto_dev_pw"

# --- Azure OpenAI ----------------------------------------------------------------
# The app runs fully without these: every model call returns a deterministic stub
# and legal retrieval falls back to its lexical arm.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=REPLACE_ME
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# --- decision envelope --------------------------------------------------------------
AUTO_APPROVE_CAP_EUR=2500
EXTRACTION_CONFIDENCE_MIN=0.85

# --- runtime ---------------------------------------------------------------------------
ASPNETCORE_URLS=http://localhost:8080
# UPLOADS_DIR=/absolute/path/to/uploads
