@{
    var path = Context.Request.Path.Value ?? "/";
    var returnUrl = path + Context.Request.QueryString;
    var name = Auth.UserName(User);
}
<!DOCTYPE html>
<html lang="@I18n.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Mijn schadedossier")</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%2316232e'/><path fill='%23fff' fill-rule='evenodd' d='M13,10H24V18H21V25H35Q41,25,41,21.5Q41,18,35,18H33V10H39Q49,10,49,20V24Q49,33,40,33Q51,33,51,43V46Q51,56,41,56H13ZM21,41H36Q43,41,43,44.5Q43,48,36,48H21Z'/><rect x='25.5' y='3' width='6' height='22' rx='1' fill='%23d95d0f'/></svg>" />
</head>
<body>
<header class="top">
    <div class="wrap">
        <a class="brand" href="/portal">
            <span style="align-self:center;display:inline-flex" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" rx="14" fill="#16232e"/><path fill="#fff" fill-rule="evenodd" d="M13 10H24V18H21V25H35Q41 25 41 21.5Q41 18 35 18H33V10H39Q49 10 49 20V24Q49 33 40 33Q51 33 51 43V46Q51 56 41 56H13ZM21 41H36Q43 41 43 44.5Q43 48 36 48H21Z"/><rect x="25.5" y="3" width="6" height="22" rx="1" fill="#d95d0f"/></svg></span>
            <span>Boxora</span>
            <span class="tag">@T("portal.brand")</span>
        </a>
        <nav class="main">
            <a class="btn" href="/portal/new">@T("portal.newClaim")</a>
            <span class="langswitch">
                @foreach (var code in I18n.Supported)
                {
                    <a class="@(I18n.Current == code ? "on" : "")"
                       href="/lang/@code?returnUrl=@Uri.EscapeDataString(returnUrl)">@code.ToUpperInvariant()</a>
                }
            </span>
            <form method="post" action="/logout" class="row" style="gap:8px">
                <span class="tiny muted">@name</span>
                <button class="btn-ghost" type="submit">@T("login.logout")</button>
            </form>
        </nav>
    </div>
</header>

<main>
    <div class="wrap" style="max-width:820px">
        @RenderBody()
    </div>
</main>

<footer class="bottom">
    <div class="wrap" style="max-width:820px">
        Boxora · @T("portal.brand")
    </div>
</footer>
</body>
</html>
