@page "/workflows"
@model WorkflowsModel
@{
    ViewData["Title"] = T("wf.title") + " · Boxora";
}

<div class="between" style="margin-bottom:20px">
    <h1>@T("wf.title")</h1>
    <span class="tiny muted">@T("wf.subtitle")</span>
</div>

@if (Model.Notice is { Length: > 0 })
{
    <div class="card" style="border-color:var(--ok);background:var(--ok-bg);margin-bottom:16px">
        <div class="small">@T("wf.notice." + Model.Notice)</div>
    </div>
}

<div class="grid g2" style="align-items:flex-start">
    <section class="card">
        <h2>@T("wf.newTitle")</h2>
        <form method="post" asp-page-handler="Create" class="stack">
            <label class="field">
                <span class="label">@T("wf.name")</span>
                <input asp-for="NewName" required placeholder="@T("wf.namePlaceholder")" />
            </label>
            <label class="field">
                <span class="label">@T("wf.trigger")</span>
                <select asp-for="NewTrigger">
                    <option value="manual">@T("wf.trigger.manual")</option>
                    <option value="new_claim">@T("wf.trigger.newClaim")</option>
                </select>
                <span class="tiny muted">@T("wf.triggerHint")</span>
            </label>
            <div style="text-align:right">
                <button type="submit">@T("wf.create")</button>
            </div>
        </form>
    </section>

    <section class="card">
        <div class="spread" style="margin-bottom:12px">
            <h2>@T("wf.existing", Model.Items.Count)</h2>
        </div>
        @if (Model.Items.Count == 0)
        {
            <p class="small muted">@T("wf.none")</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>@T("wf.name")</th>
                        <th>@T("wf.trigger")</th>
                        <th>@T("wf.status")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var w in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@w.Name</strong>
                            <div class="tiny mono muted">@w.Id</div>
                        </td>
                        <td class="tiny">@w.TriggerKind.Replace('_', ' ')</td>
                        <td>
                            <span class="badge @(w.Active ? "ok" : "")">@(w.Active ? T("wf.active") : T("wf.inactive"))</span>
                        </td>
                        <td class="row" style="gap:6px;justify-content:flex-end">
                            <a class="btn btn-ghost small" href="/workflows/@w.Id">@T("wf.open")</a>
                            <a class="btn small" href="/workflows/@w.Id/builder">⇄ @T("wfb.openBuilder")</a>
                            <form method="post" asp-page-handler="Delete" style="display:inline"
                                  onsubmit="return confirm('@T("wf.confirmDelete")');">
                                <input type="hidden" name="id" value="@w.Id" />
                                <button class="btn-ghost small" type="submit"
                                        style="color:var(--stop);border-color:#EFCFC2">@T("wf.delete")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</div>

<section class="card" style="margin-top:16px">
    <h2>@T("wf.recentRuns")</h2>
    @if (Model.RecentRuns.Count == 0)
    {
        <p class="small muted">@T("wf.noRuns")</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>@T("wf.when")</th>
                    <th>@T("wf.workflow")</th>
                    <th>@T("wf.claim")</th>
                    <th>@T("wf.runStatus")</th>
                    <th>@T("wf.error")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.RecentRuns)
            {
                <tr>
                    <td class="mono tiny" style="white-space:nowrap">@r.StartedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td><a href="/workflows/@r.WorkflowId">@(r.WorkflowName ?? r.WorkflowId)</a></td>
                    <td>
                        @if (r.ClaimId is null) { <text>—</text> }
                        else { <a href="/claims/@r.ClaimId">@(r.ClaimNumber ?? r.ClaimId)</a> }
                    </td>
                    <td>
                        <span class="badge @(r.Status == "ok" ? "ok" : r.Status == "error" ? "stop" : "warn")">
                            @r.Status
                        </span>
                    </td>
                    <td class="tiny muted">@(r.Error ?? "")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
